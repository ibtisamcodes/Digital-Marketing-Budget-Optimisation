# =============================================================================
# YouTube Data API v3 Configuration
# =============================================================================
# Obtain an API key from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Enable the "YouTube Data API v3" service under "Enabled APIs & Services".
#
# Replace the placeholder below with your personal API key:
YOUTUBE_API_KEY=your_youtube_api_key_here

# Local Express Server Port (Default: 3000)
PORT=3000

